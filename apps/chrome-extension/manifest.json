{
  "manifest_version": 3,
  "name": "Open Harness CUA",
  "description": "Allow selected Chrome tabs for your local agent and save signed-in sessions locally.",
  "version": "0.1.8",
  "key": "",
  "permissions": ["debugger", "nativeMessaging", "tabs", "storage", "cookies"],
  "optional_host_permissions": ["<all_urls>"],
  "background": { "service_worker": "service-worker.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "Open Harness CUA" }
}
