{
  "manifest_version": 3,
  "name": "T3 Browser",
  "description": "Allow selected Chrome tabs for your local T3 agent and save signed-in sessions locally.",
  "version": "0.1.7",
  "key": "",
  "permissions": ["debugger", "nativeMessaging", "tabs", "storage", "cookies"],
  "optional_host_permissions": ["<all_urls>"],
  "background": { "service_worker": "service-worker.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "T3 Browser" }
}
